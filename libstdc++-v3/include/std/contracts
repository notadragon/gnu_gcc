  // From P2900R14

  enum class assertion_kind : __UINT16_TYPE__ {
    unspecified = 0,
    pre = 1,
    post = 2,
    assert = 3,
    // P3290's enumerators exist only with its library API, as in libc++.
#ifdef __cpp_lib_contracts_api
    manual = 4,
    cassert = 5,
#endif
    // P3098's only with postcondition captures, likewise.
#ifdef __cpp_contracts_postcondition_captures
    post_capture = 6,
#endif
    implicit = 7, // P3100 implicit contract assertion guarding language UB

    /* Implementation-defined values should have a minimum value of 1000. */
  };

  enum class evaluation_semantic : __UINT16_TYPE__ {
    unspecified = 0,
    ignore = 1,
    observe = 2,
    enforce = 3,
    quick_enforce = 4,
    assume = 5, // P3100 "assume" evaluation semantic
    noexcept_observe = 6, // P4298
    noexcept_enforce = 7, // P4298

    /* Implementation-defined values should have a minimum value of 1000.  */
  };

  enum class detection_mode : __UINT16_TYPE__ {
    unspecified = 0,
    predicate_false = 1,
    evaluation_exception = 2,

    /* Implementation-defined values should have a minimum value of 1000. */
  };

  class evaluation_semantic_set {
    unsigned _M_bits = 0;

    // Every semantic this implementation provides: the P3400 standard four
    // and the extensions assume, noexcept_observe, noexcept_enforce, prove
    // and diagnose.  unspecified is a "no semantic" sentinel, not a
    // semantic, so all(), ~ and the never_X labels leave it out, although a
    // set can contain it.
    static constexpr unsigned _S_all = 0x3feu;

  public:
    constexpr evaluation_semantic_set() = default;
    constexpr evaluation_semantic_set(const evaluation_semantic_set&) = default;
    constexpr evaluation_semantic_set(evaluation_semantic __s)
    : _M_bits(1u << static_cast<unsigned>(__s)) { }
    constexpr
    evaluation_semantic_set(std::initializer_list<evaluation_semantic> __il)
    : _M_bits(0)
    { insert(__il); }

    constexpr evaluation_semantic_set&
    operator=(const evaluation_semantic_set&) = default;

    constexpr bool contains(evaluation_semantic __s) const
    { return _M_bits & (1u << static_cast<unsigned>(__s)); }

    constexpr std::size_t size() const
    { return __builtin_popcount(_M_bits); }

    constexpr bool empty() const { return _M_bits == 0; }

    constexpr void clear() { _M_bits = 0; }

    constexpr void insert(evaluation_semantic __s)
    { _M_bits |= (1u << static_cast<unsigned>(__s)); }

    constexpr void insert(std::initializer_list<evaluation_semantic> __il)
    { for (auto __s : __il)
	insert(__s); }

    constexpr void erase(evaluation_semantic __s)
    { _M_bits &= ~(1u << static_cast<unsigned>(__s)); }

    constexpr evaluation_semantic_set&
    operator&=(const evaluation_semantic_set& __rhs)
    {
      _M_bits &= __rhs._M_bits;
      return *this;
    }

    constexpr evaluation_semantic_set&
    operator|=(const evaluation_semantic_set& __rhs)
    {
      _M_bits |= __rhs._M_bits;
      return *this;
    }

    constexpr evaluation_semantic_set operator~() const
    {
      evaluation_semantic_set __r;
      __r._M_bits = ~_M_bits & _S_all;
      return __r;
    }

    static constexpr evaluation_semantic_set all()
    {
      evaluation_semantic_set __r;
      __r._M_bits = _S_all;
      return __r;
    }

    static constexpr evaluation_semantic_set none() { return {}; }

    friend constexpr evaluation_semantic_set
    operator&(const evaluation_semantic_set& __a,
	      const evaluation_semantic_set& __b)
    { return evaluation_semantic_set(__a) &= __b; }

    friend constexpr evaluation_semantic_set
    operator|(const evaluation_semantic_set& __a,
	      const evaluation_semantic_set& __b)
    { return evaluation_semantic_set(__a) |= __b; }

    friend constexpr bool
    operator==(const evaluation_semantic_set& __a,
	       const evaluation_semantic_set& __b)
    { return __a._M_bits == __b._M_bits; }
  };

  // P3400 [support.contract.control.semfun].  The extensions are classified
  // by behaviour: noexcept_observe and noexcept_enforce check the predicate,
  // and noexcept_enforce terminates on a violation; assume, prove, diagnose
  // and unspecified check nothing (prove and diagnose have no run-time
  // effect; they are diagnosed at compile time instead).
  //
  // is_continuing is not the negation of is_terminating: continuing after a
  // violation under assume is undefined behaviour, so assume is neither.
  // unspecified is continuing and not terminating: it might do anything, so
  // it could continue, and it does not promise to terminate.
  constexpr bool
  is_checked(evaluation_semantic __s)
  {
    return __s == evaluation_semantic::observe
	|| __s == evaluation_semantic::enforce
	|| __s == evaluation_semantic::quick_enforce
	|| __s == evaluation_semantic::noexcept_observe
	|| __s == evaluation_semantic::noexcept_enforce;
  }

  constexpr bool
  is_unchecked(evaluation_semantic __s)
  { return !contracts::is_checked(__s); }

  constexpr bool
  is_terminating(evaluation_semantic __s)
  {
    return __s == evaluation_semantic::enforce
	|| __s == evaluation_semantic::quick_enforce
	|| __s == evaluation_semantic::noexcept_enforce;
  }

  constexpr bool
  is_continuing(evaluation_semantic __s)
  {
    return __s == evaluation_semantic::unspecified
	|| __s == evaluation_semantic::ignore
	|| __s == evaluation_semantic::observe
	|| __s == evaluation_semantic::noexcept_observe
	|| __s == evaluation_semantic::prove
	|| __s == evaluation_semantic::diagnose;
  }

  enum class violation_handled : int { not_handled = 0, handled = 1 };

  class contract_violation {
    const __cxxabiv1::__cxa_contract_data_block* _M_chain;

    // [support.contract.violation]: no user-accessible constructor.  The
    // runtime never constructs one either: it passes the address of a
    // compiler-emitted data block whose first member is the chain.
    explicit
    contract_violation(
	const __cxxabiv1::__cxa_contract_data_block* __chain) noexcept
    : _M_chain(__chain) {}

  public:
    contract_violation(const contract_violation&) = delete;
    contract_violation& operator=(const contract_violation&) = delete;

    assertion_kind kind() const noexcept;
    evaluation_semantic semantic() const noexcept;
    contracts::detection_mode detection_mode() const noexcept;
    const char* comment() const noexcept;
    const char* message() const noexcept;
    std::source_location location() const noexcept;
    bool is_terminating() const noexcept;
    void* query_control_object(const void* __key,
			       std::size_t __index = 0) const;
  };

  // P3400: classifies the evaluation semantics that never propagate an
  // exception out of contract-violation handling.  This is a free function
  // (not a contract_violation member, unlike is_terminating above) because
  // it classifies a bare evaluation_semantic value rather than a violation
  // that has already occurred.  Gated the same way as is_terminating: it is
  // unconditionally available whenever the base contracts API
  // (__cpp_lib_contracts) is enabled, not behind __cpp_lib_contracts_labels
  // -- the classification is a static property of the enumerators, usable
  // regardless of whether P3400 labels are themselves in use.
  constexpr bool
  is_nonthrowing(evaluation_semantic __s) noexcept
  {
    return __s == evaluation_semantic::ignore
	|| __s == evaluation_semantic::quick_enforce
	|| __s == evaluation_semantic::assume
	|| __s == evaluation_semantic::noexcept_enforce
	|| __s == evaluation_semantic::noexcept_observe;
  }

  void
  invoke_default_contract_violation_handler(const contract_violation&) noexcept;

} // namespace contracts

