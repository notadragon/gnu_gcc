#
# contracts_link_flags -- compute the library path needed to find
# libcontracts.  Note we deliberately do NOT add -lcontracts here: the driver
# auto-links it for -fcontracts-p4299 (and, for C++, via -lstdc++exp).  The
# harness only needs to make the library findable, so that the tests can rely
# on the flag pulling in the dependency.
#

proc contracts_link_flags { paths } {
    global srcdir
    global ld_library_path
    global shlib_ext

    set gccpath ${paths}
    set flags ""

    set shlib_ext [get_shlib_extension]

    if { $gccpath != "" } {
      if { [file exists "${gccpath}/libcontracts/.libs/libcontracts.a"]
	   || [file exists "${gccpath}/libcontracts/.libs/libcontracts.${shlib_ext}"] } {
	  append flags " -L${gccpath}/libcontracts/.libs "
	  append ld_library_path ":${gccpath}/libcontracts/.libs"
      }
    } else {
      global tool_root_dir

      # lookfor_file finds the libcontracts *source* directory, which holds no
      # built library; the objects live in its .libs.  Point at that, and only
      # when something is actually there.
      set libcontracts [lookfor_file ${tool_root_dir} libcontracts]
      if { $libcontracts != ""
	   && ( [file exists "${libcontracts}/.libs/libcontracts.a"]
		|| [file exists "${libcontracts}/.libs/libcontracts.${shlib_ext}"] ) } {
	  append flags "-L${libcontracts}/.libs "
	  append ld_library_path ":${libcontracts}/.libs"
      }
    }

    set_ld_library_path_env_vars

    return "$flags"
}

#
# contracts_init -- called at the start of the subdir of tests
#

proc contracts_init { args } {
    global TEST_ALWAYS_FLAGS
    global TOOL_OPTIONS
    global contracts_saved_TEST_ALWAYS_FLAGS

    set link_flags ""
    if ![is_remote host] {
	if [info exists TOOL_OPTIONS] {
	    set link_flags "[contracts_link_flags [get_multilibs ${TOOL_OPTIONS}]]"
	} else {
	    set link_flags "[contracts_link_flags [get_multilibs]]"
	}
    }

    # No -lcontracts appended: the driver adds it for -fcontracts-p4299.

    if [info exists TEST_ALWAYS_FLAGS] {
	set contracts_saved_TEST_ALWAYS_FLAGS $TEST_ALWAYS_FLAGS
	set TEST_ALWAYS_FLAGS "$link_flags $TEST_ALWAYS_FLAGS"
    } else {
	set TEST_ALWAYS_FLAGS "$link_flags"
    }

    # Gate the suite on libcontracts actually being linkable via the flag.
    return [check_no_compiler_messages_nocache libcontracts_available executable {
	int f (int x) _Pre (x > 0);
	int f (int x) { return x; }
	int main (void) { return f (1) == 1 ? 0 : 1; }
    } "-fcontracts-p4299 -fcontract-evaluation-semantic=observe"]
}

#
# contracts_finish -- called at the end of the subdir of tests
#

proc contracts_finish { args } {
    global TEST_ALWAYS_FLAGS
    global contracts_saved_TEST_ALWAYS_FLAGS

    if [info exists contracts_saved_TEST_ALWAYS_FLAGS] {
	set TEST_ALWAYS_FLAGS $contracts_saved_TEST_ALWAYS_FLAGS
    } else {
	unset TEST_ALWAYS_FLAGS
    }
    clear_effective_target_cache
}
