namespace contracts
{
  // From P2900R14

  enum class assertion_kind : __UINT16_TYPE__ {
    unspecified = 0,
    pre = 1,
    post = 2,
    assert = 3,
    manual = 4,
    cassert = 5,
    post_capture = 6,
    implicit = 7, // P3100 implicit contract assertion guarding language UB

    /* Implementation-defined values should have a minimum value of 1000. */
  };

  enum class evaluation_semantic : __UINT16_TYPE__ {
    unspecified = 0,
    ignore = 1,
    observe = 2,
    enforce = 3,
    quick_enforce = 4,
    assume = 5, // P3100 "assume" evaluation semantic
    noexcept_observe = 6, // D4298
    noexcept_enforce = 7, // D4298

    /* Implementation-defined values should have a minimum value of 1000.  */
  };

  enum class detection_mode : __UINT16_TYPE__ {
    unspecified = 0,
    predicate_false = 1,
    evaluation_exception = 2,

    /* Implementation-defined values should have a minimum value of 1000. */
  };

  class evaluation_semantic_set {
    unsigned _M_bits = 0;
  public:
    constexpr evaluation_semantic_set() = default;
    constexpr evaluation_semantic_set(const evaluation_semantic_set&) = default;
    constexpr evaluation_semantic_set(evaluation_semantic __s)
    : _M_bits(1u << (static_cast<unsigned>(__s) - 1)) { }
    constexpr
    evaluation_semantic_set(std::initializer_list<evaluation_semantic> __il)
    : _M_bits(0)
    { for (auto __s : __il)
	_M_bits |= (1u << (static_cast<unsigned>(__s) - 1)); }

    constexpr bool contains(evaluation_semantic __s) const
    { return _M_bits & (1u << (static_cast<unsigned>(__s) - 1)); }

    constexpr bool empty() const { return _M_bits == 0; }

    static constexpr evaluation_semantic_set all()
    { return {evaluation_semantic::ignore, evaluation_semantic::observe,
	      evaluation_semantic::enforce, evaluation_semantic::quick_enforce}; }

    static constexpr evaluation_semantic_set none() { return {}; }

    friend constexpr evaluation_semantic_set
    operator&(evaluation_semantic_set __a, evaluation_semantic_set __b)
    {
      evaluation_semantic_set __r;
      __r._M_bits = __a._M_bits & __b._M_bits;
      return __r;
    }

    friend constexpr evaluation_semantic_set
    operator|(evaluation_semantic_set __a, evaluation_semantic_set __b)
    {
      evaluation_semantic_set __r;
      __r._M_bits = __a._M_bits | __b._M_bits;
      return __r;
    }

    friend constexpr bool
    operator==(evaluation_semantic_set __a, evaluation_semantic_set __b)
    { return __a._M_bits == __b._M_bits; }
  };

  enum class violation_handled : int { not_handled = 0, handled = 1 };

  class contract_violation {
    const __cxxabiv1::__cxa_contract_data_block* _M_chain;

  public:
    // Only the ABI runtime and library internals should construct these.
    explicit
    contract_violation(
	const __cxxabiv1::__cxa_contract_data_block* __chain) noexcept
    : _M_chain(__chain) {}

    contract_violation(const contract_violation&) = delete;
    contract_violation& operator=(const contract_violation&) = delete;

    assertion_kind kind() const noexcept;
    evaluation_semantic semantic() const noexcept;
    contracts::detection_mode detection_mode() const noexcept;
    const char* comment() const noexcept;
    const char* message() const noexcept;
#if defined(__cpp_lib_contracts_report)
    // D4301: report() renders the ASan/UBSan diagnostic on demand.  It is
    // noexcept -- the definition guards the (potentially allocating,
    // potentially throwing) populator call and returns a fixed diagnostic
    // string if it throws.
    const char* report() const noexcept;
#endif
    std::source_location location() const noexcept;
    bool is_terminating() const noexcept;
    void* query_control_object(const void* __key,
			       std::size_t __index = 0) const;
  };

  // P3400: classifies the evaluation semantics that never propagate an
  // exception out of contract-violation handling.  This is a free function
  // (not a contract_violation member, unlike is_terminating above) because
  // it classifies a bare evaluation_semantic value rather than a violation
  // that has already occurred.  Gated the same way as is_terminating: it is
  // unconditionally available whenever the base contracts API
  // (__cpp_lib_contracts) is enabled, not behind __cpp_lib_contracts_labels
  // -- the classification is a static property of the enumerators, usable
  // regardless of whether P3400 labels are themselves in use.
  constexpr bool
  is_nonthrowing(evaluation_semantic __s) noexcept
  {
    return __s == evaluation_semantic::ignore
	|| __s == evaluation_semantic::quick_enforce
	|| __s == evaluation_semantic::assume
	|| __s == evaluation_semantic::noexcept_enforce
	|| __s == evaluation_semantic::noexcept_observe;
  }

  void
  invoke_default_contract_violation_handler(const contract_violation&) noexcept;

} // namespace contracts

_GLIBCXX_END_NAMESPACE_VERSION
} // namespace std

#endif // __cpp_lib_contracts

