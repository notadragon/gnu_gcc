namespace contracts
{
  [[noreturn]] void handle_enforced_contract_violation(
      const char* __comment,
      const std::source_location& __location
          = std::source_location::current());

  void handle_observed_contract_violation(
      const char* __comment,
      const std::source_location& __location
          = std::source_location::current());

  [[noreturn]] void handle_quick_enforced_contract_violation(
      const char* __comment,
      const std::source_location& __location
          = std::source_location::current()) noexcept;

  // D4298: the nothrow_t overloads report the *noexcept* evaluation
  // semantics only when the calling translation unit was compiled with
  // -fcontracts-p4298 (which predefines __cpp_contracts_nonthrowing_semantics).
  // To keep this a per-caller-TU decision without an ODR violation, the P4298
  // variants live in the inline namespace std::contracts::__p4298: a caller
  // with the flag binds std::contracts::handle_*_contract_violation to the
  // distinct __p4298 symbol (reporting noexcept_enforce/noexcept_observe),
  // while a caller without the flag binds the plain std::contracts symbol
  // (reporting enforce/observe).  The library provides both sets of symbols;
  // each mangled name has exactly one definition.
#ifdef __cpp_contracts_nonthrowing_semantics
  inline namespace __p4298 {
#endif

  [[noreturn]] void handle_enforced_contract_violation(
      std::nothrow_t,
      const char* __comment,
      const std::source_location& __location
          = std::source_location::current()) noexcept;

  void handle_observed_contract_violation(
      std::nothrow_t,
      const char* __comment,
      const std::source_location& __location
          = std::source_location::current()) noexcept;

#ifdef __cpp_contracts_nonthrowing_semantics
  } // inline namespace __p4298
#endif

} // namespace contracts

_GLIBCXX_END_NAMESPACE_VERSION
} // namespace std

#endif // __cpp_lib_contracts_api

#ifdef __cpp_lib_contracts_labels

namespace std _GLIBCXX_VISIBILITY(default)
{
_GLIBCXX_BEGIN_NAMESPACE_VERSION

namespace contracts
{
namespace labels
{
  struct empty_label_t {
    using assertion_control_object = empty_label_t;
  };
  inline constexpr empty_label_t empty_label{};

  // The facet concepts below follow D3400R5.  They are spelled with the
  // __is_* builtins rather than <type_traits>/<concepts> so that <contracts>
  // keeps its short include list; the requirements are the paper's.
  //
  // Every facet is invoked on a constexpr -- therefore const -- control
  // object, so each requires-expression uses a const lvalue.  A member that
  // is not usable that way, whether because it is non-const or because it is
  // inaccessible, means the type simply does not participate in the facet.

  template<typename _Tp>
  concept assertion_control_object =
    requires { typename _Tp::assertion_control_object; };

  template<typename _Tp>
  concept semantic_computation_label =
    assertion_control_object<_Tp> &&
    requires(const _Tp __t, contracts::evaluation_semantic __s) {
      contracts::evaluation_semantic(__t.compute_semantic(__s));
    };

  template<typename _Tp>
  concept allowed_semantics_label =
    assertion_control_object<_Tp> &&
    requires(const _Tp __t) {
      requires __is_const(decltype(_Tp::allowed_semantics));
      contracts::evaluation_semantic_set({__t.allowed_semantics});
    };

  template<typename _Tp>
  concept local_violation_label =
    assertion_control_object<_Tp> &&
    requires(const _Tp __t, const contracts::contract_violation& __v) {
      __t.handle_contract_violation(__v);
      requires __is_same(decltype(__t.handle_contract_violation(__v)), void)
	    || __is_convertible(decltype(__t.handle_contract_violation(__v)),
				contracts::violation_handled);
    };

  template<typename _Tp>
  concept compute_comment_label =
    assertion_control_object<_Tp> &&
    requires(const _Tp __t, const char* __c) {
      requires __is_convertible(decltype(__t.compute_comment(__c)),
				const char*);
    };

  template<typename _Tp>
  concept compute_message_label =
    assertion_control_object<_Tp> &&
    requires(const _Tp __t, const char* __m) {
      requires __is_convertible(decltype(__t.compute_message(__m)),
				const char*);
    };

  template<typename _Tp>
  concept queryable_label =
    assertion_control_object<_Tp> &&
    requires(const _Tp __t, const void* __key, std::size_t __index) {
      __t.query(__key, __index);
      requires __is_same(decltype(__t.query(__key, __index)), void*);
    };

  struct review_t {
    using assertion_control_object = review_t;
    constexpr contracts::evaluation_semantic
    compute_semantic(contracts::evaluation_semantic __in) const
    {
      if (__in == contracts::evaluation_semantic::enforce
          || __in == contracts::evaluation_semantic::quick_enforce)
	return contracts::evaluation_semantic::observe;
      return __in;
    }
  };
  inline constexpr review_t review{};

  struct fixed_message_label_t {
    using assertion_control_object = fixed_message_label_t;
    const char* _M_message;
    constexpr fixed_message_label_t(const char* __msg)
    : _M_message(__msg) { }
    constexpr const char* compute_message(const char*) const
    { return _M_message; }
  };

  // D3400R5 spells this as "group_names is a range whose elements convert to
  // string_view".  Rendered here as an indexable sequence of things that
  // convert to const char*, which avoids pulling <ranges> and <string_view>
  // into this header and matches what the rest of the implementation can
  // actually consume -- __group_count below is sizeof-based and so requires
  // an array regardless.  Generalizing both together is follow-up work.
  template<typename _Tp>
  concept identification_label =
    assertion_control_object<_Tp> &&
    requires (const _Tp __t) {
      __t.group_names[0];
      requires __is_convertible(decltype(__t.group_names[0]), const char*);
    };

  template<unsigned _N>
  struct assertion_group_label {
    using assertion_control_object = assertion_group_label<_N>;
    char group_names[1][_N];
    constexpr assertion_group_label(const char (&__name)[_N])
    {
      for (unsigned __i = 0; __i < _N; ++__i)
	group_names[0][__i] = __name[__i];
    }
  };

  template<assertion_group_label _G>
  constexpr auto operator""group() { return _G; }

  template<typename _Tp>
  constexpr unsigned __group_count = 0;

  template<identification_label _Tp>
  constexpr unsigned __group_count<_Tp> =
    sizeof(_Tp::group_names) / sizeof(_Tp::group_names[0]);

  template<typename _Tp>
  constexpr unsigned __group_max_len = 1;

  template<identification_label _Tp>
  constexpr unsigned __group_max_len<_Tp> =
    sizeof(_Tp::group_names[0]);

  // --- Combined facet bases (D3400R4 decomposed pattern) ---

  template<typename _Lhs, typename _Rhs>
  struct __combined_allowed_semantics_label
  {
    constexpr __combined_allowed_semantics_label(const _Lhs&, const _Rhs&) {}
  };

  template<typename _Lhs, typename _Rhs>
    requires allowed_semantics_label<_Lhs>
  struct __combined_allowed_semantics_label<_Lhs, _Rhs>
  {
    const contracts::evaluation_semantic_set allowed_semantics;
    constexpr __combined_allowed_semantics_label(const _Lhs& __l,
						 const _Rhs&)
    : allowed_semantics(__l.allowed_semantics) {}
  };

  template<typename _Lhs, typename _Rhs>
    requires allowed_semantics_label<_Rhs>
  struct __combined_allowed_semantics_label<_Lhs, _Rhs>
  {
    const contracts::evaluation_semantic_set allowed_semantics;
    constexpr __combined_allowed_semantics_label(const _Lhs&,
						 const _Rhs& __r)
    : allowed_semantics(__r.allowed_semantics) {}
  };

  template<typename _Lhs, typename _Rhs>
    requires allowed_semantics_label<_Lhs> && allowed_semantics_label<_Rhs>
  struct __combined_allowed_semantics_label<_Lhs, _Rhs>
  {
    const contracts::evaluation_semantic_set allowed_semantics;
    constexpr __combined_allowed_semantics_label(const _Lhs& __l,
						 const _Rhs& __r)
    : allowed_semantics(
	contracts::evaluation_semantic_set(__l.allowed_semantics)
	& contracts::evaluation_semantic_set(__r.allowed_semantics)) {}
  };

  template<typename _Lhs, typename _Rhs>
  struct __combined_identification_label
  {
    constexpr __combined_identification_label(const _Lhs&, const _Rhs&) {}
  };

  template<typename _Lhs, typename _Rhs>
    requires identification_label<_Lhs>
  struct __combined_identification_label<_Lhs, _Rhs>
  {
    static constexpr unsigned __lc = __group_count<_Lhs>;
    static constexpr unsigned __ml = __group_max_len<_Lhs>;
    char group_names[__lc][__ml];
    constexpr __combined_identification_label(const _Lhs& __l, const _Rhs&)
    : group_names{}
    {
      for (unsigned __i = 0; __i < __lc; ++__i)
	for (unsigned __j = 0; __j < __ml; ++__j)
	  group_names[__i][__j] = __l.group_names[__i][__j];
    }
  };

  template<typename _Lhs, typename _Rhs>
    requires identification_label<_Rhs>
  struct __combined_identification_label<_Lhs, _Rhs>
  {
    static constexpr unsigned __rc = __group_count<_Rhs>;
    static constexpr unsigned __ml = __group_max_len<_Rhs>;
    char group_names[__rc][__ml];
    constexpr __combined_identification_label(const _Lhs&, const _Rhs& __r)
    : group_names{}
    {
      for (unsigned __i = 0; __i < __rc; ++__i)
	for (unsigned __j = 0; __j < __ml; ++__j)
	  group_names[__i][__j] = __r.group_names[__i][__j];
    }
  };

  template<typename _Lhs, typename _Rhs>
    requires identification_label<_Lhs> && identification_label<_Rhs>
  struct __combined_identification_label<_Lhs, _Rhs>
  {
    static constexpr unsigned __lc = __group_count<_Lhs>;
    static constexpr unsigned __rc = __group_count<_Rhs>;
    static constexpr unsigned __tc = __lc + __rc;
    static constexpr unsigned __ml =
      __group_max_len<_Lhs> > __group_max_len<_Rhs>
	? __group_max_len<_Lhs> : __group_max_len<_Rhs>;
    char group_names[__tc][__ml];
    constexpr __combined_identification_label(const _Lhs& __l,
					      const _Rhs& __r)
    : group_names{}
    {
      unsigned __idx = 0;
      for (unsigned __i = 0; __i < __lc; ++__i)
	{
	  for (unsigned __j = 0; __j < __group_max_len<_Lhs>; ++__j)
	    group_names[__idx][__j] = __l.group_names[__i][__j];
	  ++__idx;
	}
      for (unsigned __i = 0; __i < __rc; ++__i)
	{
	  for (unsigned __j = 0; __j < __group_max_len<_Rhs>; ++__j)
	    group_names[__idx][__j] = __r.group_names[__i][__j];
	  ++__idx;
	}
    }
  };

  // --- Combined label ---

  template<typename _Lhs, typename _Rhs>
    requires requires { typename _Lhs::assertion_control_object;
			typename _Rhs::assertion_control_object; }
  struct __combined_label
    : __combined_allowed_semantics_label<_Lhs, _Rhs>
    , __combined_identification_label<_Lhs, _Rhs>
  {
    using assertion_control_object = __combined_label;

    constexpr __combined_label(const _Lhs& __lhs, const _Rhs& __rhs)
    : __combined_allowed_semantics_label<_Lhs, _Rhs>(__lhs, __rhs)
    , __combined_identification_label<_Lhs, _Rhs>(__lhs, __rhs)
    , _M_lhs(__lhs), _M_rhs(__rhs) { }

    constexpr __combined_label(const __combined_label&) = default;

    constexpr contracts::evaluation_semantic
    compute_semantic(contracts::evaluation_semantic __s) const
      requires (semantic_computation_label<_Lhs>
		|| semantic_computation_label<_Rhs>)
    {
      if constexpr (semantic_computation_label<_Lhs>)
	__s = _M_lhs.compute_semantic(__s);
      if constexpr (semantic_computation_label<_Rhs>)
	__s = _M_rhs.compute_semantic(__s);
      return __s;
    }

    constexpr const char*
    compute_comment(const char* __c) const
      requires (compute_comment_label<_Lhs>
		|| compute_comment_label<_Rhs>)
    {
      if constexpr (compute_comment_label<_Lhs>)
	__c = _M_lhs.compute_comment(__c);
      if constexpr (compute_comment_label<_Rhs>)
	__c = _M_rhs.compute_comment(__c);
      return __c;
    }

    constexpr const char*
    compute_message(const char* __m) const
      requires (compute_message_label<_Lhs>
		|| compute_message_label<_Rhs>)
    {
      if constexpr (compute_message_label<_Lhs>)
	__m = _M_lhs.compute_message(__m);
      if constexpr (compute_message_label<_Rhs>)
	__m = _M_rhs.compute_message(__m);
      return __m;
    }

    contracts::violation_handled
    handle_contract_violation(const contracts::contract_violation& __v) const
      requires (local_violation_label<_Lhs> || local_violation_label<_Rhs>)
    {
      // A handler may return void, in which case it never claims the
      // violation and the next component still runs.  The void case has to
      // be split off before the declaration: `auto __r = <void expression>'
      // is ill-formed, so testing decltype(__r) afterwards is too late.
      if constexpr (local_violation_label<_Lhs>)
	{
	  using _Ret = decltype(_M_lhs.handle_contract_violation(__v));
	  if constexpr (__is_same(_Ret, void))
	    _M_lhs.handle_contract_violation(__v);
	  else if (static_cast<contracts::violation_handled>(
		     _M_lhs.handle_contract_violation(__v))
		   == contracts::violation_handled::handled)
	    return contracts::violation_handled::handled;
	}
      if constexpr (local_violation_label<_Rhs>)
	{
	  using _Ret = decltype(_M_rhs.handle_contract_violation(__v));
	  if constexpr (__is_same(_Ret, void))
	    _M_rhs.handle_contract_violation(__v);
	  else if (static_cast<contracts::violation_handled>(
		     _M_rhs.handle_contract_violation(__v))
		   == contracts::violation_handled::handled)
	    return contracts::violation_handled::handled;
	}
      return contracts::violation_handled::not_handled;
    }

    void* query(const void* __key, std::size_t __index = 0) const
      requires (queryable_label<_Lhs> || queryable_label<_Rhs>)
    {
      if constexpr (queryable_label<_Lhs> && queryable_label<_Rhs>)
        {
          void* __r = _M_lhs.query(__key, __index);
          if (__r) return __r;
          std::size_t __lhs_count = 0;
          if (_M_lhs.query(__key, 0))
            {
              std::size_t __lo = 0, __hi = __index;
              while (__lo + 1 < __hi)
                {
                  std::size_t __mid = __lo + ((__hi - __lo) >> 1);
                  if (_M_lhs.query(__key, __mid)) __lo = __mid;
                  else __hi = __mid;
                }
              __lhs_count = __lo + 1;
            }
          return _M_rhs.query(__key, __index - __lhs_count);
        }
      else if constexpr (queryable_label<_Lhs>)
        return _M_lhs.query(__key, __index);
      else
        return _M_rhs.query(__key, __index);
    }

    _Lhs _M_lhs;
    _Rhs _M_rhs;
  };

  template<typename _Lhs, typename _Rhs>
    requires requires { typename _Lhs::assertion_control_object;
			typename _Rhs::assertion_control_object; }
  constexpr auto
  operator|(const _Lhs& __lhs, const _Rhs& __rhs)
  { return __combined_label<_Lhs, _Rhs>(__lhs, __rhs); }

