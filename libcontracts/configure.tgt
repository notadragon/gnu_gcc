# libcontracts is portable C with only a libc dependency, so it is supported
# on every target that provides a hosted C runtime.  Leave UNSUPPORTED empty
# for supported targets; set UNSUPPORTED=1 to disable on a target that cannot
# host it.  (The top-level configure disables the library when this variable
# is non-empty, so it must stay unset for supported targets.)

UNSUPPORTED=

case "${target}" in
  *-*-*)
    # Supported everywhere by default.
    ;;
esac
